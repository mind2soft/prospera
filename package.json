        "@iconify-json/material-symbols": "^1.2.97",
        "@iconify/vue": "^5.0.5",
        "@inertiajs/vite": "^3.0.0",
        "@inertiajs/vue3": "^3.10.0",
        "@laravel/passkeys": "^0.4.0",
        "@lucide/vue": "^1.66.0",
        "@tanstack/vue-query": "^5.107.1",
        "@unovis/ts": "^1.8.0",
        "@unovis/vue": "^1.8.0",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "dompurify": "^3.4.17",
        "laravel-vite-plugin": "^3.0.0",
        "marked": "^18.2.0",
        "reka-ui": "^2.11.0",
        "tailwindcss": "^4.1.1",
        "tw-animate-css": "^1.4.0",
        "vue": "^3.5.13",
        "vue-i18n": "^11.4.18",
        "vue-input-otp": "^0.4.0",
        "vue-sonner": "^2.0.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@biomejs/biome": "2.6.7",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^26.6.6",
        "@vitejs/plugin-vue": "^6.0.0",
        "typescript": "^7.0.2",
        "typescript-classic": "npm:@typescript/typescript6@^6.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0",
        "vite-plus": "1.6.0",
