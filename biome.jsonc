{
    "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
    "root": true,
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 80
    },
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true,
            "whitespaceSensitivity": "css",
            // Project convention: self-closing void elements (<input />, <br />).
            "selfCloseVoidElements": "always"
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        }
    },
    // Keep docs and YAML outside the format gate: reformatting them adds churn
    // without value, and the previous toolchain never touched them.
    "markdown": {
        "formatter": { "enabled": false }
    },
    "yaml": {
        "formatter": { "enabled": false }
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "enabled": true,
        "domains": {
            "vue": "recommended",
            "tailwind": "recommended"
        },
        "rules": {
            "preset": "recommended",
            "style": {
                // Inertia page components are single-word by convention
                // (Budget.vue, Ledger.vue, ...).
                "useVueMultiWordComponentNames": "off"
            },
            "nursery": {
                "noTailwindLegacyUtilities": "warn",
                "useTailwindShorthandClasses": "warn",
                "useTailwindSortedClasses": "warn"
            }
        }
    },
    "tailwind": {
        "stylesheet": "resources/css/app.css",
        "mergeFunctions": ["clsx", "cn"],
        "variantFunctions": ["cva"]
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "overrides": [
        {
            "includes": [
                "composer.json",
                ".github/**",
                "public/**",
                "resources/js/components/ui/**",
                "resources/views/mail/**"
            ],
            "linter": { "enabled": false },
            "formatter": { "enabled": false },
            "assist": { "enabled": false }
        }
    ]
}
